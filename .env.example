# Choose one provider: openai or nvidia. Leave blank to use the local rule-based demo.
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Create the key in NVIDIA's API Catalog. Do not commit .env.local.
NVIDIA_API_KEY=
# Copy a model ID you have access to from build.nvidia.com.
NVIDIA_MODEL=
